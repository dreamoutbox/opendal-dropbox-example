# Dropbox Short-Lived Access Token / Developer Key
DROPBOX_TOKEN="sl.u.your_access_token_here"

# Optional: Custom root folder in Dropbox (defaults to "/")
DROPBOX_ROOT="/"

# Optional: OAuth 2.0 Refresh Flow (Long-Lived Access)
# DROPBOX_REFRESH_TOKEN=""
# DROPBOX_CLIENT_ID=""
# DROPBOX_CLIENT_SECRET=""
